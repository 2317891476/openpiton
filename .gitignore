# Ignore Vivado
.Xil/*
vivado*.log
vivado*.str
vivado*.jou
vivado*.backup.*
clockInfo.txt

# Ignore local P3 debug/build workspaces and generated board artifacts.
huaprop3_build*/
!huaprop3_build66_baseline/
huaprop3_build66_baseline/debug_build/*
huaprop3_uart*/
huaprop3_sifive_uart*/
huaprop3_minimal/
huaprop3_testa/
huaprop3_openpiton/
huaprop3onecore/
p3b66/
p3b66_validated_snapshot/

# Ignore UART debug logs
uart_piton*.log

# Ignore generated bootrom binaries and Vivado artifacts in bootrom dirs
piton/design/chipset/rv64_platform/bootrom/*/*.bin
piton/design/chipset/rv64_platform/bootrom/*/vivado*
piton/design/chipset/rv64_platform/bootrom/*/devices.xml

# Ignore Claude/Codex AI config
.claude/
.codex
.codex/

# Ignore sims logs
flist
history.sims
ucli.key

# Ignore temporary pyv files
*.v.tmp
*.h.tmp
*.tmp.v
*.tmp.h

# Ignore generated .pyc files (specifically for pyhplib)
*.pyc

# Ignore deprecated automated IBM wrapper generated files
*_TWRAPPER.v.TWRAPPER.v

# trin ignore some other files
cscope.*
tags
*.bak
