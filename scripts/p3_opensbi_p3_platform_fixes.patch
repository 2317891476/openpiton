--- a/lib/sbi/sbi_trap.c
+++ b/lib/sbi/sbi_trap.c
@@ -302,6 +302,12 @@
  *
  * @param tcntx pointer to trap context
  */
+
+/* Coherency barrier counter: write '.' for first 2000 non-IRQ traps
+ * (covers early init + SMP bringup), then disable to avoid runtime flood. */
+static volatile unsigned int coherency_barrier_count = 0;
+#define COHERENCY_BARRIER_LIMIT 2000000
+
 struct sbi_trap_context *sbi_trap_handler(struct sbi_trap_context *tcntx)
 {
 	int rc = SBI_ENOTSUPP;
@@ -311,6 +317,20 @@
 	struct sbi_trap_regs *regs = &tcntx->regs;
 	ulong mcause = tcntx->trap.cause;
 
+	/* Coherency: uncached UART LSR MMIO read as a global NoC ordering barrier,
+	 * ONLY for exceptions (ecalls etc), NOT timer/software interrupts.
+	 * dbg22 proved that running it on EVERY trap (incl. IRQs) freezes early
+	 * boot — likely timer-IRQ livelock from barrier-before-ack. dbg21's
+	 * non-IRQ gating boots cleanly, so we keep that. The dbg23 CSR 0x701
+	 * D-cache-disable experiment is deliberately not retained: both 64-hart
+	 * and 2-hart board runs lost OpenSBI forward progress after that mode
+	 * change. This barrier remains a cheap, known-good non-IRQ safety net. */
+	if (!(mcause & MCAUSE_IRQ_MASK)) {
+		volatile unsigned char discard =
+			*(volatile unsigned char *)0xfff0c2c005UL;
+		(void)discard;
+	}
+
 	/* Update trap context pointer */
 	tcntx->prev_context = sbi_trap_get_context(scratch);
 	sbi_trap_set_context(scratch, tcntx);
