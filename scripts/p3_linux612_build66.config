# Linux 6.12 Build 66 one-hart board-validation fragment.
#
# Start from the upstream RISC-V defconfig, then merge this fragment.  The
# kernel remains SMP/HSM capable for later P3 scaling, while the one-hart DTB
# exposes only CPU0 on the validated Build 66 hardware.
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_NONPORTABLE=y
CONFIG_EXPERT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_HOTPLUG_CPU=y
CONFIG_RISCV_SBI=y
# CONFIG_RISCV_SBI_V01 is not set
# CONFIG_RISCV_BOOT_SPINWAIT is not set
# CONFIG_COMPAT is not set
CONFIG_RISCV_ISA_C=y
CONFIG_FPU=y
CONFIG_RISCV_ISA_FALLBACK=y
# CONFIG_RISCV_ISA_SVNAPOT is not set
# CONFIG_RISCV_ISA_SVPBMT is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBC is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_VENDOR_EXT is not set
# CONFIG_RISCV_ISA_VENDOR_EXT_ANDES is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_SIFIVE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_SOC_STARFIVE is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_THEAD is not set
# CONFIG_ARCH_VIRT is not set
# CONFIG_ARCH_CANAAN is not set

CONFIG_HZ_250=y
CONFIG_HZ=250
# CONFIG_CPU_IDLE is not set
# CONFIG_RISCV_SBI_CPUIDLE is not set
# CONFIG_SUSPEND is not set
# CONFIG_PM is not set
# CONFIG_EFI_STUB is not set
# CONFIG_EFI is not set
# CONFIG_ACPI is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_VIRTUALIZATION is not set

CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_WERROR is not set

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BINFMT_ELF=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# The validation root filesystem is the external initramfs.  Do not inherit
# the generic defconfig block stack: the first board candidate stalled inside
# loop_init while pre-creating unused loop devices.
# CONFIG_BLOCK is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_MTD is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VIRTIO_MENU is not set

CONFIG_TTY=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_RISCV_TIMER=y
CONFIG_RISCV_INTC=y
CONFIG_SIFIVE_PLIC=y

# CONFIG_MODULES is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_NET is not set
# CONFIG_PCI is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_INPUT is not set
# CONFIG_VT is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_POWER_SUPPLY is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_HID is not set
# CONFIG_MMC is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_SECURITY is not set

CONFIG_CMDLINE=""
