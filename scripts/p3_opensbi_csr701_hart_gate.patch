    csr_write(CSR_MIP, 0);
-
+
+	/*
+	 * P3_CSR701_HART_GATE: CSR 0x701 is Ariane's M-mode D-cache
+	 * enable. Writing zero bypasses the private L1 and was introduced
+	 * for the 64-hart coherent-memory workaround. Board evidence shows
+	 * that the same write never returns on the 2-hart cold-boot path.
+	 *
+	 * sbi_scratch_init() has already populated sbi_hart_count() before
+	 * sbi_hart_init() runs. Keep the workaround for larger meshes while
+	 * omitting it for one- and two-hart P3 configurations.
+	 */
+	if (sbi_hart_count() > 2)
+		asm volatile("csrw 0x701, zero" ::: "memory");
    if (cold_boot) {
        if (misa_extension('H'))
            sbi_hart_expected_trap = &__sbi_expected_trap_hext;
